class Solution {
public:
    vector<int> luckyNumbers(vector<vector<int>>& matrix) {
        vector<int> l;
        for(int i=0;i<matrix.size();i++)
        {
            int m=matrix[i][0];
            int y=0;
            for(int j=0;j<matrix[0].size();j++)
            {
                if(m>matrix[i][j])
                {
                m=matrix[i][j];
                y=j;
                }
            }
            for(int k=0;k<matrix.size();k++)
            {
                if(m<matrix[k][y])
                m=0;
            }
            if(m!=0)
            l.push_back(m);

        }
        return l;
    }
};
