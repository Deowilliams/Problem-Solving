class Solution {
public:
    void rotate(vector<int>& nums, int k) {
        k=k%nums.size();
        re(nums,0,nums.size()-1);
        re(nums,0,k-1);
        re(nums,k,nums.size()-1);
    }
    private: void re(vector<int>& nums,int s,int e)
    {
        while(s<e)
        {
            int t=nums[s];
            nums[s]=nums[e];
            nums[e]=t;
            s++;
            e--;
        }
    }
};
