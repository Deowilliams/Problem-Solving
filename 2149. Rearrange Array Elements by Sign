class Solution {
public:
    vector<int> rearrangeArray(vector<int>& nums) {
        vector<int> a(nums.size(),0);
        int p=0;
        int n=1;
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]>0)
            {
                a[p]=nums[i];
                p+=2;
            }
            else {
                a[n]=nums[i];
                n+=2;
            }
        }
        return a;
    }
};
