class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {
        vector<int> a(nums.size());
        int l=nums.size()-1;
        int o=0;
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]%2==0)
            {
                a[o]=nums[i];
                o++;
            }
            else {
                a[l]=nums[i];
                l--;
            }
        }
        return a;
    }
};
