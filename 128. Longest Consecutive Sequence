        // }
        // if(m<c)
        // m=c;

        // return m;
        unordered_set<int> hashSet(arr.begin(), arr.end());  // Insert all elements into a hash set
        int longestStreak = 0;
        
        for (int num : arr) {
            // Check if this is the start of a sequence
            if (hashSet.find(num - 1) == hashSet.end()) {
                int currentNum = num;
                int currentStreak = 1;

                // Increment currentNum and check if the next consecutive number exists
                while (hashSet.find(currentNum + 1) != hashSet.end()) {
                    currentNum += 1;
                    currentStreak += 1;
                }

                // Update longestStreak if the current streak is the longest
                longestStreak = max(longestStreak, currentStreak);
            }
        }

        return longestStreak;
    }
};

