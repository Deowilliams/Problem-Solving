public class JumpGame {
    public static boolean canJump(int[] nums) {
        int maxReach = 0;
        
        for (int i = 0; i < nums.length; i++) {
            if (i > maxReach) {
                return false; // If we can't reach this index, we're stuck.
            }
            maxReach = Math.max(maxReach, i + nums[i]); // Update the farthest reachable index.
            if (maxReach >= nums.length - 1) {
                return true; // If we can reach or exceed the last index, return true.
            }
        }
        
        return false; // If the loop completes without reaching the last index.
    }
    
    public static void main(String[] args) {
        int[] nums1 = {2, 3, 1, 1, 4};
        int[] nums2 = {3, 2, 1, 0, 4};

        System.out.println("Can jump (nums1): " + canJump(nums1)); // true
        System.out.println("Can jump (nums2): " + canJump(nums2)); // false
    }
}
