class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double s=0;
        for(int i=0;i<k;i++)
        {
            s+=nums[i];
        }
        double d=s/k;
        int l=0;
        for(int i=k;i<nums.size();i++)
        {
            s=s-nums[l]+nums[i];
            l++;
            d=max(d,s/k);
        }
        return d;
    }
};
