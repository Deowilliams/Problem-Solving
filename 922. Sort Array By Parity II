class Solution {
public:
    vector<int> sortArrayByParityII(vector<int>& nums) {
        vector<int> a(nums.size(),0);
        int e=0;
        int o=1;
        for(int i=0;i<nums.size();i++)
        {
            if(nums[i]%2==0)
            {
                a[e]=nums[i];
                e+=2;
            }
            else {
                a[o]=nums[i];
                o+=2;
            }
        }
        return a;
    }
};
