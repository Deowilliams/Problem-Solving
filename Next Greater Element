class Solution
{
    public:
    //Function to find the next greater element for each element of the array.
    vector<long long> nextLargerElement(vector<long long> arr, int n){
        // Your code here
        stack<long long> v;
        vector<long long> r(n,-1);
        
        
        for(int i=n-1;i>=0;i--)
        {
            
            
            
                while(!v.empty()&&v.top() <= arr[i])
                {
                    v.pop();
                }
               if(!v.empty())
               r[i]=v.top(); 
                
            
            
            v.push(arr[i]);
        }
        return r;
        
    }
};

