class Solution {
public:
    bool isValid(string s) {
        stack<char> v;
        for(int i=0;i<s.length();i++)
        {
            if(s[i]=='('||s[i]=='['||s[i]=='{')
            v.push(s[i]);
            else {
                if(v.empty()) return false;
                char c=v.top();
                if((s[i]==')'&&c=='(')||(s[i]==']'&&c=='[')||(s[i]=='}'&&c=='{'))
                v.pop();
                else
                return false;
            }
            
        }
        if(v.empty()) return true;

            return false;

    }
};
