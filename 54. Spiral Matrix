class Solution {
public:
    vector<int> spiralOrder(vector<vector<int>>& matrix) {
        vector<int> r;
        if (matrix.empty()) return r;  
        
        int m = matrix.size();         
        int n = matrix[0].size();             
        int minr = 0, maxr = m - 1;   
        int minc = 0, maxc = n - 1;            
        while (minr <= maxr && minc <= maxc) {
           
            for (int i = minc; i <= maxc; i++) {
                r.push_back(matrix[minr][i]);
            }
            minr++;              
            for (int i = minr; i <= maxr; i++) {
                r.push_back(matrix[i][maxc]);
            }
            maxc--;  
            
            if (minr <= maxr) {
                for (int i = maxc; i >= minc; i--) {
                    r.push_back(matrix[maxr][i]);
                }
                maxr--;              }
            
            
            if (minc <= maxc) {
                for (int i = maxr; i >= minr; i--) {
                    r.push_back(matrix[i][minc]);
                }
                minc++;  
            }
        }
        
        return r;
    }
};
