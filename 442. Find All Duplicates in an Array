class Solution {
public:
    vector<int> findDuplicates(vector<int>& nums) {
        vector<int> r;
        unordered_set<int> o;
        for(int i=0;i<nums.size();i++)
        {
            if(o.find(nums[i])!=o.end())
            r.push_back(nums[i]);
            else
            o.insert(nums[i]);
        }
        return r;
    }
};

time complexity is O(n);
