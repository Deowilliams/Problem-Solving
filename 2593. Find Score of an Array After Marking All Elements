class Solution {
    public long findScore(int[] nums) {
        int n=nums.length;
        int[][] d=new int[n][2];
        for(int i=0;i<n;i++)
        {
            d[i][0]=nums[i];
            d[i][1]=i;
        }
        Arrays.sort(d,(a,b)-> a[0]-b[0]);

        boolean[] m=new boolean[n];
        long r=0;
        for(int[] a:d)
        {
            int y=a[0];
            int o=a[1];

            if(!m[o])
            {
                r+=y;
                m[o]=true;
                if(o>0)
                m[o-1]=true;
                if(o<n-1)
                m[o+1]=true;
            }
        }
        return r;
    }
}
