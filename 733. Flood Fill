class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        if(image[sr][sc]==color) return image;
        fil(image,sr,sc,image[sr][sc],color);
        return image;
    }
    private void fil(int[][] image,int sr,int sc,int co,int color){
        if(sr<0||sr>=image.length||sc<0||sc>=image[0].length||image[sr][sc]!=co) return ;
        image[sr][sc]=color;
        fil(image,sr+1,sc,co,color);
        fil(image,sr-1,sc,co,color);
        fil(image,sr,sc+1,co,color);
        fil(image,sr,sc-1,co,color);
    }
}
