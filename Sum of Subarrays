class Solution {
  public:
    long long subarraySum(vector<int>& arr) {
        // Your code goes here
        long long s=0;
        int n=arr.size();
        long long m=1000000007;
        for(int i=0;i<arr.size();i++)
        {
            s+=(((i+1)%m)*((n-i)%m)*(arr[i]%m))%m;
            s=s%m;
        }
        return s;
    }
};

