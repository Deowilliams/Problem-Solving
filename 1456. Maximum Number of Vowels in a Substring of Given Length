class Solution {
public:
    int maxVowels(string s, int k) {
        int c=0;
        for(int i=0;i<k;i++)
        {
            if(iv(s[i]))
            c++;
        }
        cout<<c<<endl;
        int l=0;
        int d=c;
        for(int i=k;i<s.length();i++)
        {
            if(iv(s[l])) c--;
            if(iv(s[i])) c++;
            d=max(c,d);
            l++;
        }
        return d;
    }
    bool iv(char a){
    return a=='a'||a=='e'||a=='i'||a=='o'||a=='u';
    }
};
