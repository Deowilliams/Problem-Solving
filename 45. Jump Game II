class Solution {
    public int jump(int[] nums) {
        if (nums.length <= 1) {
            return 0; // If there's only one element, no jumps are needed.
        }
        
        int maxReach = 0; // The farthest we can reach so far.
        int currentEnd = 0; // The end of the current jump range.
        int jumps = 0; // Number of jumps.

        for (int i = 0; i < nums.length; i++) {
            maxReach = Math.max(maxReach, i + nums[i]); // Update the farthest reachable point.

            // If we reach the end of the current jump range:
            if (i == currentEnd) {
                jumps++; // Increment the jump count.
                currentEnd = maxReach; // Update the jump range.

                // If we've already reached or surpassed the last index, break early.
                if (currentEnd >= nums.length - 1) {
                    break;
                }
            }
        }
        
        return jumps;
    }
}
