/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public int sumNumbers(TreeNode root) {
        
        int a[]=new int[1];
        tr(root,0,a);
        return a[0];
    }
    public void tr(TreeNode root,int c,int[] a)
    {
        if(root==null) return ;
        c*=10;
        c+=root.val;
        if(root.left==null&&root.right==null)
        a[0]+=c;
        
        tr(root.left,c,a);
        tr(root.right,c,a);

    }
}
